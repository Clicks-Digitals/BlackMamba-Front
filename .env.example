# Copy to .env.local and fill in.

# ── API ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Sign-In ────────────────────────────────────────────────────────────
# OAuth 2.0 "Web application" client ID from Google Cloud Console.
# Must be the SAME value as the backend's GOOGLE_OAUTH_CLIENT_ID.
# Public by design: it is embedded in the page and carries no secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Analytics ─────────────────────────────────────────────────────────────────
# GA4 Measurement ID (Admin > Data Streams > your web stream). Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (Events Manager > Data Sources). Digits only.
# The Conversions API *access token* is server-side and lives in the backend .env.
NEXT_PUBLIC_META_PIXEL_ID=
